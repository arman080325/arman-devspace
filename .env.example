# ============================================================================
# Arman's DevSpace — Environment Configuration Template
# ============================================================================

# Database (PostgreSQL / Supabase)
# DATABASE_URL: Transaction pooler connection string (Port 6543, pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: Direct session connection string (Port 5432) for Prisma CLI migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage (Optional — enables managed Supabase Auth & Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Session Signing Secret (Required — 32+ characters random string for signing HTTP-only cookies)
SESSION_SECRET="replace-with-a-secure-32-byte-random-secret-key"

# Owner Account Bootstrap (Optional — designates initial owner email and registration token)
DEVSPACE_OWNER_EMAIL=""
DEVSPACE_OWNER_BOOTSTRAP_TOKEN=""

# GitHub Intelligence (Optional — increases GitHub REST API rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=""

# Vercel Deployment Intelligence (Optional — pulls live build & deployment status for the workspace)
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Public Application URL (Required for OAuth redirect verification and metadata generation)
# In development: http://localhost:3000
# In Vercel Preview: https://[your-preview-branch].vercel.app
# In Vercel Production: https://[your-custom-domain].com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
